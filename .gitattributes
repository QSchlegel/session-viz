# plugins/session-viz/scripts/*.mjs is BUILD OUTPUT, compiled from
# plugins/session-viz/src/*.mts by `npm run build`. It is committed because a
# Claude Code plugin is installed by copying the repo — there is no build step
# at install time, and the skills invoke `node ${CLAUDE_PLUGIN_ROOT}/scripts/…`
# directly — but it is not source and should not be read, reviewed or counted
# as though it were.
#
# `linguist-generated` does three things at once:
#   - drops it from the repository language statistics, which otherwise report
#     this project as ~89% JavaScript when every line of it is written in
#     TypeScript;
#   - collapses it in pull request diffs, so a one-line change to a .mts stops
#     showing up as two changes and reviewers read the source;
#   - excludes it from search results, where a hit in the compiled copy is
#     never the one you wanted.
plugins/session-viz/scripts/*.mjs linguist-generated=true

# Linguist's detection for `.mts` is unreliable — the extension is shared with
# MPEG transport streams, so classification falls back to content heuristics
# and a file heavy in comments and template literals gets read as JavaScript.
# On this repo that put 272 KB of TypeScript source in the JavaScript column.
# The extension is not ambiguous here: every .mts in this tree is TypeScript.
*.mts linguist-language=TypeScript

# Generated by npm, not written by anyone.
package-lock.json linguist-generated=true
